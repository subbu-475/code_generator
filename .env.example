# ============================================================
# YouTube Shorts Factory — Environment Configuration
# ============================================================

# --- AI Text Provider ---
# Supported: "gemini" | "openai" | "built-in"
# "built-in" uses the template engine (no API key required)
TEXT_PROVIDER=built-in
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Image Provider ---
# Supported: "built-in" (programmatic SVG diagrams)
IMAGE_PROVIDER=built-in

# --- Voice Provider ---
# Supported: "edge-tts" (default, free, no API key)
VOICE_PROVIDER=edge-tts
VOICE_MODEL=en-US-ChristopherNeural

# --- Server ---
PORT=3001

# --- YouTube Upload (optional) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
