{
  "defaults": {
    "resolution": "1080p",
    "fps": 30,
    "codec": "h264",
    "audioCodec": "aac",
    "format": "mp4",
    "crf": 18,
    "preset": "fast",
    "pixelFormat": "yuv420p"
  },
  "resolutions": {
    "720p": { "width": 720, "height": 1280 },
    "1080p": { "width": 1080, "height": 1920 },
    "4k": { "width": 2160, "height": 3840 }
  },
  "duration": {
    "minSeconds": 25,
    "maxSeconds": 60,
    "targetSeconds": 45,
    "scenePaddingFrames": 18
  },
  "voice": {
    "defaultProvider": "edge-tts",
    "defaultVoice": "en-US-ChristopherNeural",
    "rate": "+5%",
    "volume": 1.0
  },
  "music": {
    "volume": 0.08,
    "fadeInFrames": 30,
    "fadeOutFrames": 45
  }
}
